# =============================================================================
# SyncRide — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=SyncRide
APP_ENV=local                # local | staging | production
APP_DEBUG=true               # true in dev only — leaks errors to the browser
APP_URL=http://localhost/SRMT
APP_TIMEZONE=Europe/Lisbon

# -----------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1            # Use 127.0.0.1 on macOS+XAMPP to force TCP
DB_PORT=3306
DB_DATABASE=SR_ATUAL
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PERSISTENT=false          # Set true only in production behind a connection pool

# -----------------------------------------------------------------------------
# Session & Security
# -----------------------------------------------------------------------------
SESSION_NAME=syncride_session
SESSION_LIFETIME=86400       # seconds
REMEMBER_ME_LIFETIME=2592000 # 30 days
APP_KEY=                     # 32-byte base64 secret for signing tokens

# -----------------------------------------------------------------------------
# Cron Runner
# -----------------------------------------------------------------------------
# Master kill-switch — production scheduled jobs only run when this is true.
# Keep `false` in local environments so cron jobs never fire on dev machines.
CRON_ENABLED=false
CRON_SECRET=                 # shared secret to authorize the cron runner

# -----------------------------------------------------------------------------
# Mail (PHPMailer / SMTP)
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@syncride.local
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Integrations (optional)
# -----------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=
WPP_PORT=3001                # porta do wpp-service/server.js (Baileys HTTP server)
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=                # LLM provider used by the sync-ai-engine endpoint

# ── Flight status (AeroDataBox via RapidAPI — free tier) ─────────────────────
# Create a free key at https://rapidapi.com/aedbx-aedbx/api/aerodatabox
FLIGHT_API_KEY=
FLIGHT_API_DAILY_BUDGET=60   # upstream calls/day cap (free tier ≈ 600 units/month)
