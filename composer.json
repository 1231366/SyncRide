{
    "name": "tiagofsilva04/syncride",
    "description": "SyncRide — fleet and transfer management platform. Built with PHP 8.2, PSR-4 autoloading, and a clean MVC-inspired architecture.",
    "type": "project",
    "license": "proprietary",
    "keywords": ["fleet-management", "transfers", "php", "mvc", "pdo"],
    "authors": [
        {
            "name": "Tiago Silva",
            "email": "tiagofsilva04@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Cron\\": "cron/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
